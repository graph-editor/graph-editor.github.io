{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CP Graph Editor",
  "version": "2.0.0",
  "identifier": "com.cpgraph.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "CP Graph Visualizer & Editor",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Competitive Programming Graph Visualizer & Editor",
    "longDescription": "Ultra-clean, professional Graph Visualizer & Editor tailored for Competitive Programming with BFS, DFS, Dijkstra, Tree & DAG layouts.",
    "copyright": "Copyright © 2026 CP Graph Team",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
