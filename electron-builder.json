{
  "appId": "com.cpgraph.editor",
  "productName": "CP Graph Editor",
  "copyright": "Copyright © 2026 CP Graph Team",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/icon.png",
    "category": "Development",
    "synopsis": "Competitive Programming Graph Visualizer & Editor",
    "description": "Ultra-clean, professional Graph Visualizer & Editor tailored for Competitive Programming."
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "build/icon.ico"
  },
  "toolsets": {
    "wine": "1.0.1"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "packElevateHelper": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CP Graph Editor"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "build/icon.icns",
    "category": "public.app-category.developer-tools"
  },
  "dmg": {
    "backgroundColor": "#090d16",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  }
}
