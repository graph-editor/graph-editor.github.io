{
  "name": "cp-graph-editor",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Ultra-clean Graph Visualizer & Editor tailored for Competitive Programming",
  "author": {
    "name": "CP Graph Team",
    "email": "dev@cpgraph.local"
  },
  "homepage": "https://github.com/cpgraph/cp-graph-editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:pack": "pnpm build && electron-builder --dir",
    "package:linux": "pnpm build && electron-builder --linux",
    "package:win": "pnpm build && electron-builder --win",
    "package:mac": "pnpm build && cross-env CUSTOM_DMGBUILD_PATH=\"./scripts/dmgbuild-linux.py\" electron-builder --mac",
    "package:all": "pnpm build && electron-builder --linux && electron-builder --win && cross-env CUSTOM_DMGBUILD_PATH=\"./scripts/dmgbuild-linux.py\" electron-builder --mac"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
